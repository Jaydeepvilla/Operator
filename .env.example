# ─── Core Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgres://postgres:postgres@localhost:5432/operator_db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Payments & Subscriptions (Razorpay - India & Global) ───────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ─── Voice & SMS Telephony (Vonage Primary) ─────────────────────────────────
# Get keys from https://developer.vonage.com
VONAGE_API_KEY="..."
VONAGE_API_SECRET="..."
VONAGE_FROM_NUMBER="Operator"

# ─── Transactional Email (Resend Primary) ────────────────────────────────────
# Get keys from https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="Operator <onboarding@yourdomain.com>"

# ─── WhatsApp Business (Meta Developer Cloud API) ───────────────────────────
# Get keys from https://developers.facebook.com
META_PHONE_NUMBER_ID="..."
META_ACCESS_TOKEN="..."
META_VERIFY_TOKEN="operator_meta_verify_token"
META_APP_SECRET="..."

# ─── AI / LLM Engine (Google Gemini API Sole Provider) ──────────────────────
GEMINI_API_KEY="AIzaSy..."

# ─── Text-to-Speech Engines (Kokoro TTS & Inworld AI TTS) ───────────────────
# Kokoro runs 100% locally in-process via ONNX runtime by default (no external API key required).
# Optional: Set a dedicated external inference URL for serverless/GPU clusters (e.g. OpenAI-compatible /v1/audio/speech)
# KOKORO_TTS_URL="http://localhost:8880"
# Inworld AI TTS (inworld-tts-2 - Basic Base64 authorization key from https://platform.inworld.ai/api-keys)
INWORLD_API_KEY=""

# ─── Cron & Internal Security ───────────────────────────────────────────────
CRON_SECRET="your-secure-cron-token"
IMPERSONATION_SECRET="your-secure-impersonation-token"

# ─── Maze Usability Testing & Research (maze.co) ─────────────────────────────
# Get key from https://maze.co -> Team Settings -> Connected Websites
NEXT_PUBLIC_MAZE_API_KEY=""

